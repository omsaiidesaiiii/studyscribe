# --- Postgres / Redis (docker compose in ../docker-compose.yml) ---
DATABASE_URL=postgres://notes_user:notes_dev_password@localhost:5455/notes_app
REDIS_URL=redis://localhost:6479

# --- API ---
PORT=5055
CORS_ORIGIN=http://localhost:5273

# --- Auth ---
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
# Google OAuth *web* client id; also add http://localhost:5273 to its
# "Authorized JavaScript origins" in the Google Cloud console.
GOOGLE_CLIENT_ID=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Default model for new generations; can be overridden per request.
GEMINI_MODEL=gemini-3.8-flash

# --- Razorpay (test mode) ---
# RAZORPAY_KEY: test-mode key id (e.g. rzp_test_...). See https://dashboard.razorpay.com > Developers > API Keys.
# RAZORPAY_KEY_SECRET: the secret that pairs with that key id. BOTH are needed —
# the SDK authenticates with key_id + key_secret, so order calls fail with 401
# ("Please provide your api key") when only the key id is set.
# RAZORPAY_WEBHOOK_SECRET: the live/hmac secret shown once when you create the webhook endpoint.
# RAZORPAY_API_BASE: test-only. Points the SDK at a local stub instead of
# api.razorpay.com (used by `npm run payments:e2e`). Leave empty outside tests.
RAZORPAY_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=
